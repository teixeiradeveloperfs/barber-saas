NODE_ENV=development
PORT=7192
APP_NAME=Barber API
# Origens fixas (painel e landing). Fora de produção qualquer origem passa. Em produção o app do
# cliente não entra aqui: a origem vale quando o host resolve para uma barbearia ativa.
# Produção: CORS_ORIGINS=https://admin.barberosbr.com,https://barberosbr.com,https://www.barberosbr.com
CORS_ORIGINS=

# Postgres local (docker compose na raiz do repo)
DATABASE_URL=postgresql://barber:barber@localhost:5544/barber_dev?schema=public

# Domínio da plataforma: tenants ganham <slug>.PLATFORM_DOMAIN de graça (wildcard *.barberosbr.com;
# admin. e api. têm registro próprio e ganham do wildcard). A landing fica no apex.
PLATFORM_DOMAIN=barberosbr.com

# Primeiro admin da plataforma: criado no banco na primeira subida sem usuários.
# Depois disso, gerencie usuários pelo painel; estas variáveis viram só bootstrap.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-em-dev
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=troque-por-um-segredo-longo
# Domínios próprios: dns (produção: registro A para PLATFORM_SERVER_IP com proxy da Cloudflare; o painel
# confere DNS + HTTPS + /tenant-platform.json), noop (dev) ou cloudflare (Custom Hostnames via API).
# Sem definir: dns em produção, noop fora dela.
DOMAIN_PROVIDER=
PLATFORM_SERVER_IP=
# Só com DOMAIN_PROVIDER=cloudflare: destino do CNAME, mais token e zona abaixo.
PLATFORM_FALLBACK_HOST=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Contas de cliente do app (tokens separados do painel). Sem definir, deriva de ADMIN_JWT_SECRET.
CUSTOMER_JWT_SECRET=
# Códigos por SMS/WhatsApp via Twilio. Sem credenciais, o código vai para o log e (fora de produção) para a resposta.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Banco de imagens: pasta dos uploads (relativa à pasta do backend) e URL pública da API usada nos links.
# Em produção, MEDIA_DIR precisa ser um volume persistente.
MEDIA_DIR=storage/media
PUBLIC_API_URL=https://api.barberosbr.com
# Ícones do app instalado: a API lê logos do próprio app (/brand/...) por aqui.
APP_STATIC_URL=http://127.0.0.1:7693

# Token do script da borda que busca os domínios próprios (GET /platform/edge/domains). Vazio desliga a rota.
EDGE_SYNC_TOKEN=

# WhatsApp da barbearia: URL interna do WAHA (motor GOWS), a chave dele e, se a
# API não for alcançável pelo PUBLIC_API_URL a partir do WAHA, a URL do webhook.
# WAHA_WEBHOOK_TOKEN é opcional (sem ele, derivado da chave do WAHA).
WAHA_URL=http://barberos-waha:3000
WAHA_API_KEY=
WHATSAPP_WEBHOOK_URL=
WAHA_WEBHOOK_TOKEN=

# Mensalidade pelo Asaas. Sem ASAAS_API_KEY, a cobrança fica manual no painel.
# ASAAS_ENV=production usa a conta real; qualquer outro valor usa o sandbox.
# ASAAS_WEBHOOK_TOKEN é o token que você define no webhook do Asaas (chega em asaas-access-token).
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
# Chave Pix da conta Asaas que recebe o Pix Automático (Configurações > Chaves Pix).
ASAAS_PIX_KEY=
# Opcional: outra URL da API (padrão: produção com ASAAS_ENV=production, senão sandbox).
ASAAS_BASE_URL=

# E-mails (Resend). Sem RESEND_API_KEY, o e-mail vai para o log. EMAIL_FROM precisa
# ser de um domínio verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=BarberOS <nao-responda@barberosbr.com>
EMAIL_REPLY_TO=
# Painel usado nos links dos e-mails (primeiro acesso, esqueci a senha).
ADMIN_URL=https://admin.barberosbr.com
# Site da plataforma, para o link do parceiro nos e-mails (padrão https://<PLATFORM_DOMAIN>)
LANDING_URL=https://barberosbr.com
# Quem recebe o aviso de nova venda pelo site (padrão: ADMIN_EMAIL).
SALES_NOTIFY_EMAIL=
