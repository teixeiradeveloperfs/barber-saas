# Copie este arquivo para deploy/.env.docker e altere os valores.
# Para acesso direto por IP, troque SEU_IP_OU_DOMINIO pelo endereço da VPS.

POSTGRES_PASSWORD=troque-esta-senha-do-banco

VITE_API_URL=http://SEU_IP_OU_DOMINIO:7192
VITE_ADMIN_URL=http://SEU_IP_OU_DOMINIO:5928
VITE_LANDING_URL=http://SEU_IP_OU_DOMINIO:6400
VITE_APP_NAME=Sua Barbearia

NODE_ENV=production
PORT=7192
DATABASE_URL=postgresql://barber:troque-esta-senha-do-banco@postgres:5432/barber
