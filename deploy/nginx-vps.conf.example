# Copie para /etc/nginx/sites-available/sua-barbearia.conf
# Troque os quatro domínios antes de ativar.

upstream sua_barbearia_api {
    server 127.0.0.1:7192;
    keepalive 32;
}

server {
    listen 80;
    server_name seudominio.com.br www.seudominio.com.br;
    root /var/www/sua-barbearia/apps/landing/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name app.seudominio.com.br;
    root /var/www/sua-barbearia/apps/frontend/dist;
    index index.html;
    client_max_body_size 10m;

    location /public/ {
        proxy_pass http://sua_barbearia_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name admin.seudominio.com.br;
    root /var/www/sua-barbearia/apps/admin/dist;
    index index.html;

    location / {
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name api.seudominio.com.br;
    client_max_body_size 10m;

    location / {
        proxy_pass http://sua_barbearia_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
